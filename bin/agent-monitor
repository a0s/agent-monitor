#!/usr/bin/env node
import { readFileSync, statSync } from 'node:fs'
import { resolve } from 'node:path'
import { installHooks, removeHooks, record, snapshot, render } from '../lib/agent-monitor.mjs'

const usage = `usage: agent-monitor [folder] [--codex|--claude-code] [--json] [--short]
       agent-monitor --install-hooks [config-folder...]
       agent-monitor --remove-hooks [config-folder...]
       agent-monitor --version

Shows every Codex and Claude Code session, subagent and teammate working in the
Git repository (all of its worktrees) or folder you run it from, or in the
folder named on the command line instead. Nothing has to be installed:
sessions are read from local transcripts and processes, in ~/.claude*,
~/.codex*, $CLAUDE_CONFIG_DIR and $CODEX_HOME.

Hooks are optional. They record starts and stops as they happen, for a more
exact status. A config folder is a Claude or Codex one: ~/.claude, a second
account's ~/.claude-work, ~/.codex, or a project's own .claude or .codex.
  --install-hooks   into the folders named, or ~/.claude and ~/.codex
  --remove-hooks    from the folders named, or from everywhere they were installed`

const argv = process.argv.slice(2)
try {
  if (argv[0] === '_event') {
    record(argv[1], argv[2])
    if (argv[1] === 'SubagentStop') process.stdout.write('{}\n')
  } else if (argv[0] === '--install-hooks') {
    // The path this was started by, unresolved: Homebrew's bin link outlives an upgrade.
    for (const { path } of installHooks(argv.slice(1), resolve(process.argv[1]))) process.stdout.write(`hooks installed in ${path}\n`)
    process.stdout.write('Codex may ask you to trust the new hooks once, under /hooks.\n')
  } else if (argv[0] === '--remove-hooks') {
    const removed = removeHooks(argv.slice(1))
    for (const path of removed) process.stdout.write(`hooks removed from ${path}\n`)
    if (!removed.length) process.stdout.write('no agent-monitor hooks found\n')
  } else if (argv.includes('--version')) {
    const { version } = JSON.parse(readFileSync(new URL('../package.json', import.meta.url), 'utf8'))
    process.stdout.write(`agent-monitor ${version}\n`)
  } else if (argv.includes('--help') || argv.includes('-h')) {
    process.stdout.write(usage + '\n')
  } else {
    const json = argv.includes('--json')
    const short = argv.includes('--short')
    const only = argv.includes('--codex') ? 'codex' : argv.includes('--claude-code') ? 'claude-code' : null
    const positional = argv.filter(x => !['--json', '--short', '--codex', '--claude-code'].includes(x))
    if (positional.some(x => x.startsWith('-')) || positional.length > 1 || (argv.includes('--codex') && argv.includes('--claude-code'))) throw Error(usage)
    let cwd = process.cwd()
    if (positional.length) {
      cwd = resolve(cwd, positional[0])
      let stat; try { stat = statSync(cwd) } catch { throw Error(`no such folder: ${cwd}`) }
      if (!stat.isDirectory()) throw Error(`not a folder: ${cwd}`)
    }
    const show = () => {
      const data = snapshot(cwd, only)
      if (json) return process.stdout.write(JSON.stringify(data, null, 2) + '\n')
      const view = render(data, { short }) || `No ${only || 'Codex or Claude Code'} agents in the last 15 minutes under:\n${data.worktrees.map(tree => `  ${tree.path}`).join('\n')}`
      process.stdout.write('\x1b[2J\x1b[H' + view + '\n')
    }
    show()
    if (!json) setInterval(show, 2000)
  }
} catch (error) { console.error(error.message === usage ? usage : `agent-monitor: ${error.message}`); process.exitCode = 1 }
